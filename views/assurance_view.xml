<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_assurance_view_list" model="ir.ui.view">
            <field name="name">myautoparc.assurance.view.list</field>
            <field name="model">myautoparc.assurance</field>
            <field name="arch" type="xml">
                <list>
                    <field name="company"/>
                    <field name="type"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="amount"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_assurance_view_form" model="ir.ui.view">
            <field name="name">myautoparc.assurance.view.form</field>
            <field name="model">myautoparc.assurance</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="company"/>
                                <field name="type"/>
                                <field name="amount"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="cars" string="Related cars">
                                <field name="car_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_myautoparc_assurance">
            <field name="name">Assurance List</field>
            <field name="res_model">myautoparc.assurance</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_assurance_view_list"/>
       </record>
    </data>
</odoo>