<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_fuel_list" model="ir.ui.view">
        <field name="name">myautoparc.fuel.list</field>
        <field name="model">myautoparc.fuel</field>
        <field name="arch" type="xml">
            <list>
                <field name="car_id"/>
                <field name="date"/>
                <field name="quantite"/>
                <field name="cost"/>
            </list>
        </field>
    </record>

    <record id="view_fuel_form" model="ir.ui.view">
        <field name="name">myautoparc.fuel.form</field>
        <field name="model">myautoparc.fuel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="car_id"/>
                        <field name="date"/>
                        <field name="quantite"/>
                        <field name="cost"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fuel" model="ir.actions.act_window">
        <field name="name">Fuels</field>
        <field name="res_model">myautoparc.fuel</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="myautoparc_fuel_menu"
              name="Fuels"
              parent="myautoparc_sub_menu_conf"
              action="action_fuel"
              sequence="7"/>
</odoo>