<odoo>
    <record id="view_model_list" model="ir.ui.view">
        <field name="name">myautoparc.model.list</field>
        <field name="model">myautoparc.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand_id"/>
            </list>
        </field>
    </record>

    <record id="view_model_form" model="ir.ui.view">
        <field name="name">myautoparc.model.form</field>
        <field name="model">myautoparc.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="brand_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">myautoparc.model</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>