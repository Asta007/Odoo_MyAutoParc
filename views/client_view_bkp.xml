<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_client_view_list" model="ir.ui.view">
            <field name="name"> myautoparc.client.view.list </field>
            <field name="model"> myautoparc.client </field>
            <field name="arch" type="xml">
                <list>
                    <field name="last_name"/>
                    <field name="first_name"/>
                    <field name="phone_number"/>
                    <field name="adress"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

        <record id="myautoparc_client_view_form" model="ir.ui.view">
            <field name="name"> myautoparc.client.view.form </field>
            <field name="model"> myautoparc.client </field>
            <field name="arch" type="xml"/>

            <form>
                <sheet>
                    <group>
                        <field name="last_name"/>
                        <field name="first_name"/>
                        <field name="phone_number"/>
                        <field name="adress"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>

        </record>

    </data>
</odoo>