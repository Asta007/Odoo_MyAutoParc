<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_template_view_list" model="ir.ui.view">
            <field name="name">myautoparc.template.view.list</field>
            <field name="model">myautoparc.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="serial_number"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_template_view_form" model="ir.ui.view">
            <field name="name">myautoparc.template.view.form</field>
            <field name="model">myautoparc.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <group>
                            <group>
                                <field name="fieldname"/>
                            </group>
                            <group>
                                <field name="fieldname"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="documents" string="Related documents">
                                <field name="document_ids" widget="many2many_binary"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_myautoparc_template">
            <field name="name">template List</field>
            <field name="res_model">myautoparc_template_view_form</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_template_view_form"/>
       </record>
    </data>
</odoo>