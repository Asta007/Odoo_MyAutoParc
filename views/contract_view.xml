<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_contract_view_list" model="ir.ui.view">
            <field name="name">myautoparc.contract.view.list</field>
            <field name="model">myautoparc.contract</field>
            <field name="arch" type="xml">
                <list>
                    <field name="number"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="tarif"/>
                    <field name="car_ids"/>
                    <field name="client_id"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_contract_view_form" model="ir.ui.view">
            <field name="name">myautoparc.contract.view.form</field>
            <field name="model">myautoparc.contract</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="number"/>
                                <field name="tarif"/>
                                <field name="client_id"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="cars" string="Concerned Cars">
                                <field name="car_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_myautoparc_contract">
            <field name="name">contract List</field>
            <field name="res_model">myautoparc.contract</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_contract_view_form"/>
       </record>
    </data>
</odoo>