<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_affectation_list" model="ir.ui.view">
        <field name="name">myautoparc.affectation.list</field>
        <field name="model">myautoparc.affectation</field>
        <field name="arch" type="xml">
            <list>
                <field name="car_id"/>
                <field name="employee_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="view_affectation_form" model="ir.ui.view">
        <field name="name">myautoparc.affectation.form</field>
        <field name="model">myautoparc.affectation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="car_id"/>
                        <field name="employee_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_affectation" model="ir.actions.act_window">
        <field name="name">Affectations</field>
        <field name="res_model">myautoparc.affectation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="myautoparc_affectation_menu"
              name="Affectations"
              parent="myautoparc_sub_menu_conf"
              action="action_affectation"
              sequence="6"/>
</odoo>
