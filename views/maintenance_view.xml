<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_maintenance_view_list" model="ir.ui.view">
            <field name="name">myautoparc.maintenance.view.list</field>
            <field name="model">myautoparc.maintenance</field>
            <field name="arch" type="xml">
                <list>
                    <field name="car_id"/>
                    <field name="maintenance_type"/>
                    <field name="description"/>
                    <field name="date"/>
                    <field name="tarif"/>
                    <field name="next_date"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_maintenance_view_form" model="ir.ui.view">
            <field name="name">myautoparc.maintenance.view.form</field>
            <field name="model">myautoparc.maintenance</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="car_id"/>
                                <field name="maintenance_type"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="tarif"/>
                                <field name="next_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_myautoparc_maintenance">
            <field name="name">maintenance List</field>
            <field name="res_model">myautoparc.maintenance</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_maintenance_view_form"/>
       </record>
    </data>
</odoo>