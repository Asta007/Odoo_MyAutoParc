<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_employe_view_list" model="ir.ui.view">
            <field name="name">myautoparc.employe.view.list</field>
            <field name="model">myautoparc.employe</field>
            <field name="arch" type="xml">
                <list>
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="full_name"/>
                    <field name="post"/>
                    <field name="department"/>
                    <field name="telephone"/>
                    <field name="email"/>
                    <field name="car_id"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_employe_view_form" model="ir.ui.view">
            <field name="name">myautoparc.employe.view.form</field>
            <field name="model">myautoparc.employe</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="first_name"/>
                                <field name="last_name"/>
                                <field name="full_name"/>
                                <field name="post"/>
                                <field name="department"/>
                            </group>
                            <group>
                                <field name="telephone"/>
                                <field name="email"/>
                                <field name="car_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_myautoparc_employe">
            <field name="name">employe List</field>
            <field name="res_model">myautoparc.employe</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_employe_view_list"/>
       </record>
    </data>
</odoo>