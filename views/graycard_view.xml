<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_graycard_view_list" model="ir.ui.view">
            <field name="name">myautoparc.graycard.view.list</field>
            <field name="model">myautoparc.graycard</field>
            <field name="arch" type="xml">
                <list>
                    <field name="number"/>
                    <field name="delivery_location"/>
                    <field name="delivery_date"/>
                    <field name="exp_date"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_graycard_view_form" model="ir.ui.view">
            <field name="name">myautoparc.graycard.view.form</field>
            <field name="model">myautoparc.graycard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="number"/>
                            <field name="delivery_location"/>
                            <field name="delivery_date"/>
                            <field name="exp_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_myautoparc_graycard">
            <field name="name">graycard List</field>
            <field name="res_model">myautoparc.graycard</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_graycard_view_list"/>
       </record>
    </data>
</odoo>