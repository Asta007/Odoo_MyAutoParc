<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_list" model="ir.ui.view">
        <field name="name">myautoparc.employee.list</field>
        <field name="model">myautoparc.employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="last_name"/>
                <field name="first_name"/>
                <field name="phone_number"/>
                <field name="adress"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">myautoparc.employee.form</field>
        <field name="model">myautoparc.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="last_name"/>
                        <field name="first_name"/>
                        <field name="phone_number"/>
                        <field name="adress"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">myautoparc.employee</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="myautoparc_employee_menu"
              name="Employees"
              parent="myautoparc_sub_menu_conf"
              action="action_employee"
              sequence="10"/>
</odoo>