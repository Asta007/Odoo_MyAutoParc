<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_car_view_list" model="ir.ui.view">
            <field name="name">myautoparc.car.view.list</field>
            <field name="model">myautoparc.car</field>
            <field name="arch" type="xml">
                <list>
                    <field name="serial_number"/>
                    <field name="name"/>
                    <field name="model_id"/>
                    <field name="state"/>
                    <field name="release_date"/>
                    <field name="colors"/>
                    <field name="graycard_id"/>
                    <field name="assurance_id"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_car_view_form" model="ir.ui.view">
            <field name="name">myautoparc.car.view.form</field>
            <field name="model">myautoparc.car</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="serial_number"/>
                                <field name="colors"/>
                                <field name="release_date"/>
                                <field name="meter"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="lastcare"/>
                                <field name="brand_id"/>
                                <field name="model_id"/>
                                <field name="graycard_id"/>
                                <field name="assurance_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="documents" string="Related documents">
                                <field name="document_ids" widget="many2many_binary"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_myautoparc_car">
            <field name="name">Cars List</field>
            <field name="res_model">myautoparc.car</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_car_view_list"/>
       </record>
    </data>
</odoo>