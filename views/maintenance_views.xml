<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_maintenance_list" model="ir.ui.view">
        <field name="name">myautoparc.maintenance.list</field>
        <field name="model">myautoparc.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="car_id"/>
                <field name="date"/>
                <field name="type"/>
                <field name="cost"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_maintenance_form" model="ir.ui.view">
        <field name="name">myautoparc.maintenance.form</field>
        <field name="model">myautoparc.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="car_id"/>
                        <field name="date"/>
                        <field name="type"/>
                        <field name="cost"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenances</field>
        <field name="res_model">myautoparc.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="myautoparc_maintenance_menu"
              name="Maintenances"
              parent="myautoparc_sub_menu_conf"
              action="action_maintenance"
              sequence="8"/>
</odoo>