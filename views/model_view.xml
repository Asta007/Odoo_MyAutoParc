<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_model_view_list" model="ir.ui.view">
            <field name="name">myautoparc.model.view.list</field>
            <field name="model">myautoparc.model</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="brand_id"/>
                    <field name="body"/>
                    <field name="power"/>
                    <field name="consumption"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_model_view_form" model="ir.ui.view">
            <field name="name">myautoparc.model.view.form</field>
            <field name="model">myautoparc.model</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="brand_id"/>
                            <field name="body"/>
                            <field name="power"/>
                            <field name="consumption"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_myautoparc_model">
            <field name="name">Model List</field>
            <field name="res_model">myautoparc.model</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="myautoparc_model_view_list"/>
       </record>
    </data>
</odoo>