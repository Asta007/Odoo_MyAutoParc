<odoo>
    <record id="view_client_list" model="ir.ui.view">
        <field name="name">myautoparc.client.list</field>
        <field name="model">myautoparc.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="last_name"/>
                <field name="first_name"/>
                <field name="phone_number"/>
                <field name="adress"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_client_form" model="ir.ui.view">
        <field name="name">myautoparc.client.form</field>
        <field name="model">myautoparc.client</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="last_name"/>
                        <field name="first_name"/>
                        <field name="phone_number"/>
                        <field name="adress"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_client" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">myautoparc.client</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>