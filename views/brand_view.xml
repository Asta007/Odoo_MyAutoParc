<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="myautoparc_brand_view_list" model="ir.ui.view">
            <field name="name">myautoparc.brand.view.list</field>
            <field name="model">myautoparc.brand</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="country_id"/>
                    <field name="foundation_date"/>
                </list>
            </field>
        </record>
        <record id="myautoparc_brand_view_form" model="ir.ui.view">
            <field name="name">myautoparc.brand.view.form</field>
            <field name="model">myautoparc.brand</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="country_id"/>
                            <field name="foundation_date"/>
                        </group>
                        <notebook>
                            <page name="brandmodels" string="Related Model">
                                <field name="model_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>